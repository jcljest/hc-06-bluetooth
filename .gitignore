.venv/
__pycache__/
.pio/
.DS_Store

# AI_AGENT_EXECUTIVE runtime state (ephemeral, machine-local)
.claude/runtime/

# AI_AGENT_EXECUTIVE shared-repo symlinks + location marker — these are
# absolute-path symlinks generated by bootstrap_project.sh and point at
# wherever THIS machine cloned the shared repo. Never commit them: a
# teammate with the shared repo cloned to a different path needs their
# own symlinks, regenerated by re-running bootstrap_project.sh locally.
.claude/skills
.claude/agents
.claude/hooks
.claude/rules
.claude/templates
.claude/scripts
.claude/.shared-repo-path
